{:paths ["src"]
 ;; hikap is the hiccup engine; babashka.fs locates the Tcl/Tk libraries.
 :deps {babashka/fs {:mvn/version "0.5.34"}
        kmet/hikap {:git/url "https://github.com/kmetia/hikap.git"
                    :git/sha "f9db3d61ae0d0bc9dbaee1d47158e56daecfb2c6"}}
 :aliases
 {:test {:extra-paths ["test"]
         :override-deps {kmet/hikap {:local/root "../hikap"}
                         kmet/reakt {:local/root "../reakt"}}
         ;; The standalone JVM FFI; babashka bundles it and Jolt has jolt.ffi.
         :extra-deps {org.babashka/ffi {:mvn/version "0.1.3"}}}}}
